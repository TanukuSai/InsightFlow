# InsightFlow Backend Environment Configuration (Public Demo Model)
APP_ENV=development
PROJECT_NAME="InsightFlow API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Public Demo Workspace
PUBLIC_DEMO_WORKSPACE_ID=ws-production-eval
CANONICAL_DATASET_ID=ds-796d15b9a096

# Database Configuration
# Local SQLite for deterministic offline demo & testing:
DATABASE_URL=sqlite+aiosqlite:///./insightflow.db
# Optional PostgreSQL / Supabase connection (if deploying persistent database):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# CORS Configuration (Explicit origins, NO wildcards)
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://frontend-bay-ten-95.vercel.app"]

# Public Upload Bounds & Quotas
MAX_UPLOAD_SIZE_MB=10
MAX_CSV_ROWS=20000

# Rate Limiting Controls
RATE_LIMIT_IMPORTS_PER_HOUR=3
RATE_LIMIT_ANALYSES_PER_10M=3
RATE_LIMIT_REPORTS_PER_HOUR=5
RATE_LIMIT_FEEDBACK_PER_HOUR=30
RATE_LIMIT_READS_PER_MINUTE=120

# Adaption Cloud Operations (Kill switch disabled by default for public safety)
ENABLE_PUBLIC_ADAPTION_OPERATIONS=False
ADAPTION_API_KEY=
ADAPTION_MAX_ROWS=1000
